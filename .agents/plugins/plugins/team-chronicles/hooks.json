{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CHRONICLE_PLUGIN}/hooks/session-start.sh",
            "statusMessage": "Syncing team chronicles",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CHRONICLE_PLUGIN}/hooks/user-prompt-submit.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CHRONICLE_PLUGIN}/hooks/stop.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
